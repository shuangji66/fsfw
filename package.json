{
  "name": "fsfw",
  "private": true,
  "version": "1.0.0",
  "description": "fpkstudio for Windows — Tauri desktop shell",
  "scripts": {
    "tauri": "tauri",
    "dev": "npm run build:backend && tauri dev",
    "build": "npm run build:backend && tauri build",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "test:backend": "cd backend && go test ./...",
    "typecheck": "npm --prefix frontend run typecheck",
    "check": "npm --prefix frontend run check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
